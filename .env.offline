# ======================================
# Bolt.diy Offline Configuration
# ======================================
# This configuration is optimized for offline usage with LM Studio
# Primary: Uses LM Studio on localhost:1234 for all AI operations
# Secondary: Supports cloud providers if internet + API keys are available

# ======================================
# LM STUDIO (Local Models) - PRIMARY
# ======================================
# Local language model server running on your machine
# Download LM Studio from: https://lmstudio.ai
# Start LM Studio and load your preferred model
# IMPORTANT: Enable CORS in LM Studio settings
# DON'T USE http://localhost:1234 due to IPv6 issues
# ALWAYS USE: http://127.0.0.1:1234
LMSTUDIO_API_BASE_URL=http://127.0.0.1:1234

# ======================================
# OPTIONAL: CLOUD PROVIDER API KEYS
# ======================================
# Keep these commented out to use offline with LM Studio only
# Uncomment and add your API keys if you want to use cloud providers
# When both LM Studio and cloud providers are configured, you can
# switch between them in the Settings UI

# Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT models
# OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini
# GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key_here

# Groq (Fast inference)
# GROQ_API_KEY=your_groq_api_key_here

# Mistral
# MISTRAL_API_KEY=your_mistral_api_key_here

# ======================================
# OPTIONAL: OTHER LOCAL MODEL SERVERS
# ======================================
# If you also use Ollama, configure it here
# OLLAMA_API_BASE_URL=http://127.0.0.1:11434

# ======================================
# OPTIONAL: GITHUB INTEGRATION
# ======================================
# For cloning repositories and GitHub integration
# VITE_GITHUB_ACCESS_TOKEN=your_github_personal_access_token_here

# ======================================
# DEVELOPMENT SETTINGS
# ======================================
# Node environment
NODE_ENV=production

# Application port (inside Docker container, default is 5173)
PORT=5173

# Logging level
VITE_LOG_LEVEL=info

# Default context window size for local models
DEFAULT_NUM_CTX=8192
